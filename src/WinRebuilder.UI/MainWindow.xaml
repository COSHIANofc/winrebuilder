<Window x:Class="WinRebuilder.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding WindowTitle}"
        Width="1060" Height="760" MinWidth="780" MinHeight="580" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="27" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,5" /></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,26,16,18">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="WinRebuilder" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,2" />
          <TextBlock Text="Windows setup" Style="{StaticResource MutedText}" Margin="10,0,0,30" />
          <Button Content="Software" Style="{StaticResource NavButton}" Background="{Binding SoftwareNavBrush}" Command="{Binding SoftwarePageCommand}" />
          <Button Content="ExplorerPatcher" Style="{StaticResource NavButton}" Background="{Binding ExplorerNavBrush}" Command="{Binding ExplorerPageCommand}" />
          <Button Content="Configuration" Style="{StaticResource NavButton}" Background="{Binding ConfigurationNavBrush}" Command="{Binding ConfigurationPageCommand}" />
          <Button Content="About" Style="{StaticResource NavButton}" Background="{Binding AboutNavBrush}" Command="{Binding AboutPageCommand}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="{Binding ThemeLabel}" Style="{StaticResource NavButton}" Command="{Binding ToggleThemeCommand}" />
          <TextBlock Text="{Binding PublicVersion}" Style="{StaticResource MutedText}" Margin="10,12,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,22,28,22">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="165" /></Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid Visibility="{Binding SoftwareVisibility}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,20"><TextBlock Text="Software" Style="{StaticResource PageTitle}" /><TextBlock Text="Applications configured in config.yml" Style="{StaticResource MutedText}" /></StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
              <Grid Margin="14,8,14,6"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <TextBlock Text="APPLICATION" Style="{StaticResource MutedText}" FontSize="11" />
                <TextBlock Grid.Column="1" Text="PACKAGE ID" Style="{StaticResource MutedText}" FontSize="11" />
                <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource MutedText}" FontSize="11" />
              </Grid>
              <TextBlock Grid.Row="1" Text="No software is configured. Add a winget package to begin." Style="{StaticResource MutedText}" Visibility="{Binding EmptySoftwareVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <ListBox Grid.Row="1" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}">
                <ListBox.ItemTemplate><DataTemplate><Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Provider}" Style="{StaticResource MutedText}" /></StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Id}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" />
                </Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Margin="0,16,0,20">
            <WrapPanel>
              <Button Content="Add software" Command="{Binding AddCommand}" Margin="0,0,8,8" />
              <Button Content="Remove from config" Command="{Binding RemoveCommand}" Margin="0,0,8,8" />
              <Button Content="Install selected" Command="{Binding InstallSelectedCommand}" Margin="0,0,8,8" />
              <Button Content="Install all" Style="{StaticResource PrimaryButton}" Command="{Binding InstallAllCommand}" Margin="0,0,8,8" />
              <Button Content="Reload" Command="{Binding ReloadCommand}" Margin="0,0,8,8" />
              <Button Content="Check status" Command="{Binding CheckStatusCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="Removing an entry changes config.yml; it does not uninstall the application." Style="{StaticResource MutedText}" />
          </StackPanel>
        </Grid>
        <Grid Visibility="{Binding ExplorerVisibility}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,20"><TextBlock Text="ExplorerPatcher" Style="{StaticResource PageTitle}" /><TextBlock Text="Shell changes run after ordinary software installation." Style="{StaticResource MutedText}" /></StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel>
            <CheckBox Content="Install ExplorerPatcher in the final phase" IsChecked="{Binding ExplorerPatcherEnabled}" />
            <TextBlock Text="Settings file" FontWeight="SemiBold" Margin="0,24,0,6" />
            <TextBlock Text="{Binding ExplorerSettingsFile}" Style="{StaticResource MutedText}" />
            <TextBlock Text="Only validated ExplorerPatcher settings are accepted. A copy is stored beside config.yml." Style="{StaticResource MutedText}" Margin="0,7,0,18" />
            <WrapPanel><Button Content="Choose .reg file" Command="{Binding SelectRegCommand}" Margin="0,0,8,8" /><Button Content="Apply settings" Style="{StaticResource PrimaryButton}" Command="{Binding ApplySettingsCommand}" Margin="0,0,8,8" /></WrapPanel>
          </StackPanel></Border>
        </Grid>
        <Grid Visibility="{Binding ConfigurationVisibility}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,20"><TextBlock Text="Configuration" Style="{StaticResource PageTitle}" /><TextBlock Text="Review your profile and recover saved registry values." Style="{StaticResource MutedText}" /></StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="Profile location" FontWeight="SemiBold" /><TextBlock Text="{Binding ConfigurationPath}" Style="{StaticResource MutedText}" Margin="0,6,0,14" />
            <Button Content="Reload config.yml" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" />
          </StackPanel></Border>
          <Border Grid.Row="2" Style="{StaticResource Card}"><DockPanel>
            <StackPanel DockPanel.Dock="Top"><TextBlock Text="Registry backups" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Select a backup to restore its previous value. Later edits are protected." Style="{StaticResource MutedText}" Margin="0,4,0,12" /></StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Load backups" Command="{Binding LoadBackupsCommand}" Margin="0,0,8,0" /><Button Content="Restore selected" Command="{Binding RollbackCommand}" /></StackPanel>
            <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding FullPath}" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding BackupId}" Style="{StaticResource MutedText}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          </DockPanel></Border>
        </Grid>
        <StackPanel Visibility="{Binding AboutVisibility}"><TextBlock Text="About WinRebuilder" Style="{StaticResource PageTitle}" />
          <Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel>
            <TextBlock Text="WinRebuilder" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding PublicVersion}" Style="{StaticResource MutedText}" Margin="0,5,0,20" />
            <TextBlock Text="Rebuild a Windows 11 environment from your reviewed config.yml. Changes are planned and logged; registry values are backed up before writes." TextWrapping="Wrap" />
            <TextBlock Text="© COSHIAN" Style="{StaticResource MutedText}" Margin="0,20,0,0" />
          </StackPanel></Border>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,8,0,0"><DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="Activity" FontWeight="SemiBold" FontSize="15" /><Button Grid.Column="1" Content="Cancel operation" Command="{Binding CancelCommand}" MinHeight="28" Padding="10,3" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,5" /><ListBox ItemsSource="{Binding Log}" FontSize="12" />
      </DockPanel></Border>
    </Grid>
  </Grid>
</Window>
