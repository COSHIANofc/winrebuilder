<Window x:Class="WinRebuilder.UI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WinRebuilder" Width="850" Height="620" MinWidth="680" MinHeight="480">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="WinRebuilder" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Software in config.yml" Margin="0,4,0,10" />
      <DataGrid ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}" AutoGenerateColumns="False"
                IsReadOnly="True" CanUserAddRows="False" Height="250">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="110" />
          <DataGridTextColumn Header="Package ID" Binding="{Binding Id}" Width="2*" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
        </DataGrid.Columns>
      </DataGrid>
      <WrapPanel Margin="0,10,0,12">
        <Button Content="Add" Command="{Binding AddCommand}" Margin="0,0,8,0" Padding="12,5" />
        <Button Content="Remove from config" Command="{Binding RemoveCommand}" Margin="0,0,8,0" Padding="12,5" />
        <Button Content="Install Selected" Command="{Binding InstallSelectedCommand}" Margin="0,0,8,0" Padding="12,5" />
        <Button Content="Install All" Command="{Binding InstallAllCommand}" Margin="0,0,8,0" Padding="12,5" />
        <Button Content="Reload" Command="{Binding ReloadCommand}" Margin="0,0,8,0" Padding="12,5" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="12,5" />
      </WrapPanel>
      <GroupBox Header="ExplorerPatcher" Padding="10" IsEnabled="{Binding CanEdit}">
        <StackPanel>
          <CheckBox Content="Install ExplorerPatcher in final phase" IsChecked="{Binding ExplorerPatcherEnabled}" />
          <TextBlock Text="Selected settings file:" Margin="0,8,0,0" />
          <TextBlock Text="{Binding ExplorerSettingsFile}" />
          <WrapPanel Margin="0,8,0,0">
            <Button Content="Select .reg file" Command="{Binding SelectRegCommand}" Margin="0,0,8,0" Padding="12,5" />
            <Button Content="Apply settings" Command="{Binding ApplySettingsCommand}" Padding="12,5" />
          </WrapPanel>
        </StackPanel>
      </GroupBox>
    </StackPanel>
    <GroupBox Header="Status and log" Margin="0,12,0,0">
      <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding Log}" />
      </DockPanel>
    </GroupBox>
  </DockPanel>
</Window>
